# SINAS Agent integration
# Use the API host (no management-console port)
VITE_SINAS_BASE_URL=https://via-5.sinas.wearebrain.com
VITE_SINAS_API_KEY=replace-with-your-sinas-key
# Optional explicit task endpoint (if your deployment exposes one)
VITE_SINAS_ENDPOINT=
# Optional: set true only if /run endpoints exist on your SINAS deployment
VITE_SINAS_ENABLE_DIRECT_TASK_ENDPOINTS=false
# User UUID or external user identifier
VITE_SINAS_USER_ID=demo-user
# Optional: pin a specific runtime agent
VITE_SINAS_AGENT_NAMESPACE=gym-trainer
VITE_SINAS_AGENT_NAME=Personal_Trainer

# Existing Google Calendar integration
VITE_GOOGLE_CLIENT_ID=
